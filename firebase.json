{
  "hosting": {
    "site": "kumtechgateway-237",
    "public": "site-recovery",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/@(about|services|projects|faq|contact|referral|referral-policy)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/brand/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/images/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          }
        ]
      },
      {
        "source": "**/*.@(txt|xml)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/home.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/about.html",
        "destination": "/about",
        "type": 301
      },
      {
        "source": "/services.html",
        "destination": "/services",
        "type": 301
      },
      {
        "source": "/contact.html",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/faq.html",
        "destination": "/faq",
        "type": 301
      },
      {
        "source": "/audit.html",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/audit",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/branding-services.html",
        "destination": "/services",
        "type": 301
      },
      {
        "source": "/web-design-services.html",
        "destination": "/services",
        "type": 301
      },
      {
        "source": "/seo-services.html",
        "destination": "/services",
        "type": 301
      },
      {
        "source": "/google-business-services.html",
        "destination": "/services",
        "type": 301
      },
      {
        "source": "/ads-management-services.html",
        "destination": "/services",
        "type": 301
      },
      {
        "source": "/pricing.html",
        "destination": "/services",
        "type": 301
      },
      {
        "source": "/blog.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/blog",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/blog-post.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/blog/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/portfolio",
        "destination": "/projects",
        "type": 301
      },
      {
        "source": "/portfolio.html",
        "destination": "/projects",
        "type": 301
      },
      {
        "source": "/gallery.html",
        "destination": "/projects",
        "type": 301
      },
      {
        "source": "/project-detail.html",
        "destination": "/projects",
        "type": 301
      },
      {
        "source": "/projects/**",
        "destination": "/projects",
        "type": 301
      },
      {
        "source": "/referral/index.html",
        "destination": "/referral",
        "type": 301
      },
      {
        "source": "/referral-policy/index.html",
        "destination": "/referral-policy",
        "type": 301
      },
      {
        "source": "/privacy-policy.html",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/terms-of-service.html",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/project-terms-refund-policy.html",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/admin.html",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
